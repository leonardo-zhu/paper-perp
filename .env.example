# Copy to apps/gateway/.env for local development, or to the server next to
# compose.yaml for deployments. Every variable has a safe dev default.

# dev | staging | prod — used in logs, metrics and Sentry
APP_ENV=dev
LOG_LEVEL=info

# binance | hyperliquid | mock (offline, deterministic, used by e2e)
MARKET_SOURCE=binance

# Chain the EIP-712 domain and SIWE messages are bound to (421614 = Arbitrum Sepolia).
# Must match VITE_CHAIN_ID used when building the web app.
CHAIN_ID=421614

# Browser origins allowed for CORS/CSRF/WebSocket upgrades, and the matching SIWE domain(s).
ALLOWED_ORIGINS=http://localhost:5173
SIWE_DOMAINS=localhost:5173

DATABASE_PATH=./data/paperperp.db
SESSION_TTL_HOURS=24
# Seconds without upstream data before the market is marked stale (ms).
STALE_AFTER_MS=5000

# Behind a reverse proxy: trust X-Forwarded-For and send Secure cookies.
TRUST_PROXY=false
# COOKIE_SECURE=true

# Exposes POST /api/dev/fault for chaos drills. Never enable in prod.
ENABLE_FAULT_INJECTION=false

# Optional error tracking
# SENTRY_DSN=
